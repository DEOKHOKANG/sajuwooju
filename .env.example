# OpenAI API Key (필수)
OPENAI_API_KEY=

# Site URL (Vercel 배포 시 자동 설정됨)
NEXT_PUBLIC_SITE_URL=

# Admin API URL (enterprise-simplified 서버)
NEXT_PUBLIC_API_URL=https://sajuwooju-enterprise.vercel.app

# Site Customization
NEXT_PUBLIC_SITE_NAME=사주우주
NEXT_PUBLIC_SITE_TAGLINE=우주의 법칙으로 읽는 나의 운명
NEXT_PUBLIC_PRIMARY_COLOR=#7B68EE

# Database (Vercel Postgres - 필수)
# Pooled connection for serverless functions
DATABASE_URL=

# Direct connection for migrations (Vercel Postgres)
POSTGRES_URL_NON_POOLING=

# NextAuth.js Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Kakao OAuth
KAKAO_CLIENT_ID="your-kakao-rest-api-key"
KAKAO_CLIENT_SECRET="your-kakao-client-secret"
